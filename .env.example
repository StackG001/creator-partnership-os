# ---------------------------------------------------------------------------
# Creator Partnership OS — environment
# Copy to .env and fill in. `npm run doctor` verifies every line below.
# Never commit .env.
# ---------------------------------------------------------------------------

# --- Core: required ---------------------------------------------------------

# Anthropic API key. Every LLM call in this repo goes through it.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# SQLite for now. Path is relative to prisma/. Swap for a Supabase/Postgres
# connection string when we migrate (and change the datasource provider).
DATABASE_URL="file:./dev.db"

# --- Models: optional, sensible defaults --------------------------------------

# Workhorse model: scoring, audits, outreach, funnel copy.
ANTHROPIC_MODEL=claude-sonnet-5
# Heavy model: long-form product writing and research synthesis.
ANTHROPIC_MODEL_HEAVY=claude-opus-5
# Cheap model: classification, dedupe, extraction, cleanup passes.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Only set if you route through a proxy or gateway.
# ANTHROPIC_BASE_URL=

# Max tokens per completion and how many times a call is retried when the model
# returns JSON that fails schema validation.
LLM_MAX_TOKENS=8192
LLM_MAX_RETRIES=2
# Log every prompt/response to outputs/_llm/ for debugging. true|false
LLM_TRACE=false

# --- Discovery: optional until the finder module lands ------------------------

# YouTube Data API v3 key — channel search, stats, video metadata.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Apify token — Instagram profile/post scraping (no official IG API for this).
# Also authenticates the `apify` MCP server in .mcp.json; export it in your
# shell for Claude Code to pick it up (see README → MCP servers).
# https://console.apify.com/account/integrations
APIFY_TOKEN=

# Web search for product research (pick one; Brave is the cheapest).
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# --- Publishing: optional until the publisher module lands --------------------

# Whop API key + company id — creates products, plans and checkout links.
# https://whop.com/dashboard/developer/
WHOP_API_KEY=
WHOP_COMPANY_ID=

# --- Local behaviour ----------------------------------------------------------

# Where generated artifacts land: <OUTPUTS_DIR>/<creator-handle>/
OUTPUTS_DIR=./outputs
# debug | info | warn | error
LOG_LEVEL=info
# Chromium executable for HTML->PDF. Leave blank to use Playwright's own copy.
# PLAYWRIGHT_CHROMIUM_PATH=
