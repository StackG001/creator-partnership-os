# Chromium is provisioned by the environment / `npx playwright install chromium`.
# Keep installs fast and deterministic in CI.
fund=false
audit=false

# Some sandboxes (this one included) advertise IPv6 routes that don't
# actually work, so Node's fetch (undici) burns its connect timeout on dead
# IPv6 attempts before ever trying IPv4 — surfaces as a generic "fetch failed"
# / ETIMEDOUT against hosts like googleapis.com and api.resend.com, even
# though curl to the same host works fine. Forcing IPv4-first resolution and
# disabling Happy Eyeballs' family autoselection fixes it (verified: 13/13
# clean requests vs. failures without these flags). Applies automatically to
# every `npm run <script>` — no per-script changes needed.
node-options=--dns-result-order=ipv4first --no-network-family-autoselection
